{
  "name": "hlidskjalf-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Hliðskjálf desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "package:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hlidskjalf.desktop",
    "productName": "Hliðskjálf",
    "asar": true,
    "directories": {
      "output": "dist/windows-electron"
    },
    "files": [
      "electron/**/*",
      "crates/hlidskjalf-ui/ui/**/*",
      "crates/hlidskjalf-desktop/assets/hlidskjalf.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/windows/resources/bin",
        "to": "bin",
        "filter": ["hlidskjalf.exe", "hlidskjalfd.exe", "hlidskjalf-motion.exe"]
      }
    ],
    "win": {
      "icon": "crates/hlidskjalf-desktop/assets/hlidskjalf.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hliðskjálf",
      "artifactName": "Hlidskjalf-Setup-x64.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
